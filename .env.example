# ── AgencyOS environment variables ───────────────────────────────────────────
# Copy to .env and fill in. Only DATABASE_URL + BETTER_AUTH_SECRET are REQUIRED.
# Google + email are OPTIONAL and env-gated: absent = feature disabled gracefully.

# REQUIRED — PostgreSQL connection (Prisma / Better Auth)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agencyos?schema=public"

# REQUIRED at runtime — Better Auth signing secret (generate a long random string)
BETTER_AUTH_SECRET=""
# Base URL of the app (used for auth callbacks). Defaults to request origin if unset.
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OPTIONAL — Google OAuth. Add BOTH to auto-enable "Continue with Google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPTIONAL — Email sending via Resend. Add the key to auto-enable email
# verification + password reset. Absent = those flows are disabled gracefully.
RESEND_API_KEY=""
EMAIL_FROM="AgencyOS <onboarding@resend.dev>"

# OPTIONAL — Razorpay. Add BOTH to auto-enable "Proceed to Payment" at checkout.
# key_id is NOT secret (also used by the client checkout widget); key_secret is.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# OPTIONAL — Razorpay webhook secret (configured in the Razorpay dashboard, NOT
# the API key secret). Required to verify /api/webhooks/razorpay; absent = every
# webhook is rejected 401 (the authoritative settlement path is disabled).
RAZORPAY_WEBHOOK_SECRET=""

# OPTIONAL — Access allowlists (comma-separated emails). Until the role backend
# lands, these gate the admin surface (/admin) and the employee workspace
# (/employee). Admins implicitly count as employees.
ADMIN_EMAILS=""
EMPLOYEE_EMAILS=""
# OPTIONAL — Finance manager allowlist (gates the /finance surface).
FINANCE_MANAGER_EMAILS=""

# OPTIONAL — Local file storage root for deliverable bytes. Defaults to
# `<project>/.storage` (git-ignored). Point at a mounted volume in production.
LOCAL_STORAGE_DIR=""

# ── Observability ────────────────────────────────────────────────────────────
# OPTIONAL — Structured logging level: debug | info | warn | error.
# Blank = info in production, debug otherwise.
LOG_LEVEL=""
# OPTIONAL — future integration seams (no-ops until wired). Presence flips the
# corresponding hook to "enabled" so a real exporter can be attached later.
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# ── Deployment / build metadata ──────────────────────────────────────────────
# OPTIONAL — surfaced by /api/version. Usually injected by CI at build time.
GIT_COMMIT_SHA=""


# ── AI Operations Platform ───────────────────────────────────────────────────
# OPTIONAL — an AI layer that READS existing data to generate insights,
# summaries and recommendations. It never mutates business data. Absent keys =
# AI insights render as graceful placeholders (feature disabled, never crashes).
#
# Provider is switchable by CONFIG only. Implemented: openai, anthropic.
# Declared-but-disabled (abstraction ready): google, openrouter, local.
AI_PROVIDER="anthropic"
# Model / temperature / max tokens / system prompt are all configurable. Blank =
# per-provider defaults (see @/constants/ai).
AI_MODEL=""
AI_TEMPERATURE="0.4"
AI_MAX_TOKENS="1024"
AI_SYSTEM_PROMPT=""

# Provider API keys — add the one matching AI_PROVIDER to enable live insights.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""
# Base URL for a future local/self-hosted LLM (abstraction only, not implemented).
AI_LOCAL_BASE_URL=""
